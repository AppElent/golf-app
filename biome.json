{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"convex/**/*",
			"!convex/_generated",
			"scripts/check-mobile-structure*",
			"apps/mobile/app/**/*",
			"apps/mobile/*.{ts,tsx,js}",
			"**/.vscode/**/*",
			"**/index.html",
			"**/vite.config.ts",
			"!apps/mobile/expo-env.d.ts",
			"!apps/mobile/ios",
			"!apps/mobile/android",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css",
			"!**/src/__fixtures__",
			"!**/.claude"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"useReactNativePlatformComponents": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": ["apps/mobile/**"],
			"linter": {
				"rules": {
					"correctness": {
						"noReactNativeRawText": {
							"level": "error",
							"options": {
								"skip": ["AppText"]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"apps/mobile/src/**",
				"apps/mobile/app/**",
				"!**/*.test.*",
				"!apps/mobile/src/convex/query-cache.tsx"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"convex/react": {
										"importNames": [
											"useQuery",
											"useQueries",
											"usePaginatedQuery"
										],
										"message": "Import query hooks from src/convex/query-cache (docs/standards/convex-query-caching.md)."
									}
								}
							}
						}
					}
				}
			}
		}
	]
}
