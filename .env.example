# Clerk
# Clerk publishable key (required)
VITE_CLERK_PUBLISHABLE_KEY=

# Convex
# Convex deployment name
CONVEX_DEPLOYMENT=
# Convex deployment URL (required)
VITE_CONVEX_URL=

# CLERK_JWT_ISSUER_DOMAIN is required for the Clerk<->Convex auth bridge but is
# a server-side Convex deployment var, not a local one - set it with:
#   pnpm exec convex env set CLERK_JWT_ISSUER_DOMAIN <clerk-frontend-api-url>
# (and `convex env default set ... --type preview` for PR previews)

