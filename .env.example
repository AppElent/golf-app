# Generated by @appelent/dev env generate — do not edit by hand.
#
# Canonical source keys for fairway.
# Infisical folders, in override order: /, /fairway
# Routing source of truth: env.manifest.ts

# Clerk publishable key: `pk_test_` in dev, `pk_live_` in staging and prod.
# Infisical: clerk-publishable-key
#   VITE_CLERK_PUBLISHABLE_KEY (vite-build: local, production)
#   EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY (expo-build: local, preview, production)
#   EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY (expo-local: local)
#   published, required
clerk-publishable-key=

# Issuer Convex trusts. A deployment without it refuses every signed-in call.
# Infisical: clerk-jwt-issuer-domain
#   CLERK_JWT_ISSUER_DOMAIN (convex-functions: local, production)
#   published, required
clerk-jwt-issuer-domain=

# Clerk development-instance `pk_test_` key for the web preview and staging builds on workers.dev.
# Infisical: web-test-clerk-publishable-key
#   VITE_CLERK_PUBLISHABLE_KEY (vite-build: preview, staging)
#   published, required
web-test-clerk-publishable-key=

# Clerk development-instance issuer for the PR-preview and staging backends.
# Infisical: web-test-clerk-jwt-issuer-domain
#   CLERK_JWT_ISSUER_DOMAIN (convex-functions: preview, staging)
#   published, required
web-test-clerk-jwt-issuer-domain=

# Convex cloud URL the clients connect to. The phone needs the cloud URL, never localhost.
# Infisical: convex-url
#   VITE_CONVEX_URL (vite-build: local, preview, staging, production)
#   EXPO_PUBLIC_CONVEX_URL (expo-build: local, preview, production)
#   EXPO_PUBLIC_CONVEX_URL (expo-local: local)
#   published, required
convex-url=

# Deploy key: preview kind in staging (PR previews), production kind in prod.
# Infisical: convex-deploy-key
#   CONVEX_DEPLOY_KEY (workflow: preview, production)
#   secret, required
convex-deploy-key=

# `prod:` deploy key of the staging deployment. The deploy workflow refuses a missing or non-`prod:` key.
# Infisical: convex-staging-deploy-key
#   CONVEX_DEPLOY_KEY (workflow: staging)
#   secret, optional
convex-staging-deploy-key=

# One-tap dev sign-in. Honoured only with a `pk_test_` key.
# Infisical: test-user-email
#   EXPO_PUBLIC_TEST_USER_EMAIL (expo-local: local)
#   published, optional
test-user-email=

# Password for that test user, published by design, so the account exists only on the development instance.
# Infisical: test-user-password
#   EXPO_PUBLIC_TEST_USER_PASSWORD (expo-local: local)
#   published, optional
test-user-password=

# Public Sentry DSN. Clients report from deployed hosts and release builds only.
# Infisical: sentry-dsn
#   VITE_SENTRY_DSN (vite-build: preview, staging, production)
#   EXPO_PUBLIC_SENTRY_DSN (expo-build: preview, production)
#   published, optional
sentry-dsn=

# Sentry organisation slug, for debug-symbol and source-map upload.
# Infisical: sentry-org
#   SENTRY_ORG (eas-tooling: preview, production)
#   published, optional
sentry-org=

# Sentry project slug, for debug-symbol and source-map upload.
# Infisical: sentry-project
#   SENTRY_PROJECT (eas-tooling: preview, production)
#   published, optional
sentry-project=

# Uploads source maps and debug symbols from deployed and released builds only.
# Infisical: sentry-auth-token
#   SENTRY_AUTH_TOKEN (workflow: preview, staging, production)
#   SENTRY_AUTH_TOKEN (eas-tooling: preview, production)
#   secret, optional
sentry-auth-token=

# Google Maps SDK key for the Android satellite view (iOS uses Apple Maps). Without it Android draws the schematic.
# Infisical: google-maps-android-api-key
#   GOOGLE_MAPS_ANDROID_API_KEY (eas-tooling: local, preview, production)
#   secret, optional
google-maps-android-api-key=

# EAS access for the Mobile Build and Mobile Update workflows, which run without a GitHub Environment.
# Infisical: expo-token
#   EXPO_TOKEN (workflow: preview)
#   secret, required
expo-token=

# Cloudflare token CI uses to deploy and delete Workers and attach the custom domain.
# Infisical: cloudflare-account-token
#   CLOUDFLARE_API_TOKEN (workflow: preview, staging, production)
#   secret, required
cloudflare-account-token=

# Cloudflare account CI deploys Workers to.
# Infisical: cloudflare-account-id
#   CLOUDFLARE_ACCOUNT_ID (workflow: preview, staging, production)
#   published, required
cloudflare-account-id=
