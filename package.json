{
  "name": "golf-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000 --host",
    "dev:watch": "concurrently -n convex,vite -c blue,green \"pnpm exec convex dev\" \"pnpm dev\"",
    "generate-routes": "tsr generate",
    "build": "vite build && node scripts/remove-client-sourcemaps.mjs",
    "typecheck": "tsc --noEmit && tsc -p convex --noEmit && pnpm --filter @fairway/core typecheck && pnpm --filter @fairway/mobile typecheck",
    "test": "vitest run",
    "lint:fix": "biome check --write",
    "check": "biome check && pnpm check:mobile-structure && pnpm check:repo-layout",
    "cf-typegen": "wrangler types",
    "env": "node scripts/env.mjs",
    "env:check": "node scripts/env.mjs check",
    "courses:geometry": "node scripts/course-data/refresh-geometry.mjs",
    "sentry:convex": "SENTRY_APP=fairway-convex SENTRY_DSN=${SENTRY_DSN:-$VITE_SENTRY_DSN} node scripts/convex-sentry.mjs",
    "courses:sync": "pnpm exec convex run courseCatalog:sync",
    "test:mobile": "pnpm --filter @fairway/mobile test",
    "check:mobile-structure": "node scripts/check-mobile-structure.mjs",
    "check:repo-layout": "node scripts/check-repo-layout.mjs"
  },
  "dependencies": {
    "@clerk/react": "^6.18.4",
    "@cloudflare/vite-plugin": "^1.66.0",
    "@fairway/core": "workspace:*",
    "@sentry/cloudflare": "11.10.0",
    "@sentry/react": "11.10.0",
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.169.4",
    "convex": "^1.49.0",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@edge-runtime/vm": "^5.0.0",
    "@sentry/node": "11.10.0",
    "@sentry/vite-plugin": "11.10.0",
    "@tanstack/devtools-vite": "^0.8.6",
    "@tanstack/router-cli": "^1.167.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "convex-test": "^0.0.54",
    "jsdom": "^28.1.0",
    "lefthook": "^2.2.2",
    "sharp": "0.34.5",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.70.0"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  }
}
