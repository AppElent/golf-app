{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"noEmit": true,
		// src/osm.ts also runs under plain Node (scripts/course-data), which
		// resolves only explicit extensions.
		"allowImportingTsExtensions": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noUncheckedSideEffectImports": true,
		"noFallthroughCasesInSwitch": true,
		"resolveJsonModule": true,
		// No DOM, no Node: this code also runs on Hermes and in Convex.
		"lib": ["ES2022"],
		"types": []
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.test.ts"]
}
