{
	"name": "@fairway/core",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Framework-free golf domain logic shared by the web app, Convex, and apps/mobile. Ships raw TypeScript (Vite, Convex esbuild and Metro all resolve it); keep it dependency-free.",
	"exports": {
		"./club-suggest": "./src/club-suggest.ts",
		"./course-suggestion": "./src/course-suggestion.ts",
		"./features": "./src/features.ts",
		"./format": "./src/format.ts",
		"./geo": "./src/geo.ts",
		"./handicap": "./src/handicap.ts",
		"./hole-advance": "./src/hole-advance.ts",
		"./hole-projection": "./src/hole-projection.ts",
		"./hole-view": "./src/hole-view.ts",
		"./loops": "./src/loops.ts",
		"./par-stats": "./src/par-stats.ts",
		"./recap": "./src/recap.ts",
		"./round": "./src/round.ts",
		"./scoring": "./src/scoring.ts",
		"./shots": "./src/shots.ts",
		"./simulation": "./src/simulation.ts",
		"./stats": "./src/stats.ts"
	},
	"dependencies": {},
	"scripts": {
		"typecheck": "tsc --noEmit"
	}
}
