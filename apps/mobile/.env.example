# Public values inlined into the bundle (never secrets).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Device-reachable Convex URL (the cloud dev deployment, not localhost).
EXPO_PUBLIC_CONVEX_URL=
# Optional one-tap dev sign-in; only honoured with a pk_test_ key.
EXPO_PUBLIC_TEST_USER_EMAIL=
EXPO_PUBLIC_TEST_USER_PASSWORD=

# Build-time only (not inlined): Google Maps SDK key for Android satellite view.
GOOGLE_MAPS_ANDROID_API_KEY=
