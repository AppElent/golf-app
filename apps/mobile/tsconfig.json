{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"types": ["jest", "react"],
		// Its exports send the react-native condition to raw src/, which
		// doesn't typecheck under strict; the published types are fine.
		"paths": {
			"react-native-view-shot": ["./node_modules/react-native-view-shot/lib/index.d.ts"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
