{
	"expo": {
		"slug": "fairway",
		"version": "1.0.0",
		"runtimeVersion": {
			"policy": "fingerprint"
		},
		"updates": {
			"url": "https://u.expo.dev/e42512f9-8d86-4f78-8dd5-85383f239df7"
		},
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"userInterfaceStyle": "automatic",
		"backgroundColor": "#f3f4ef",
		"ios": {
			"supportsTablet": false,
			"usesAppleSignIn": true,
			"infoPlist": {
				"CFBundleAllowMixedLocalizations": true,
				"ITSAppUsesNonExemptEncryption": false
			}
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#0f3d2a",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"backgroundColor": "#f3f4ef",
			"predictiveBackGestureEnabled": false,
			"blockedPermissions": [
				"android.permission.RECORD_AUDIO",
				"android.permission.READ_EXTERNAL_STORAGE",
				"android.permission.WRITE_EXTERNAL_STORAGE"
			]
		},
		"plugins": [
			"expo-router",
			"@clerk/expo",
			["expo-secure-store", { "faceIDPermission": false }],
			["expo-localization", { "supportedLocales": ["en", "nl"] }],
			"expo-sqlite",
			[
				"@sentry/react-native/expo",
				{
					"url": "https://sentry.io/",
					"organization": "appelent",
					"project": "fairway"
				}
			],
			"expo-web-browser",
			"expo-apple-authentication",
			"expo-font",
			"expo-image",
			[
				"expo-location",
				{
					"locationWhenInUsePermission": "Fairway uses your location on the course to measure distances to the green, hazards and your target.",
					"locationAlwaysAndWhenInUsePermission": "With 'Always', Fairway keeps your distances and hole ready while the phone is locked during a round. Only during an active round.",
					"isIosBackgroundLocationEnabled": true,
					"isAndroidBackgroundLocationEnabled": true,
					"isAndroidForegroundServiceEnabled": true
				}
			],
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#f3f4ef",
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 76,
					"dark": { "backgroundColor": "#08130d" }
				}
			]
		],
		"locales": {
			"en": "./locales/en.json",
			"nl": "./locales/nl.json"
		},
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": { "projectId": "e42512f9-8d86-4f78-8dd5-85383f239df7" }
		},
		"owner": "appelent"
	}
}
